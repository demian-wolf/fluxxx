{
  "name": "flux-agent",
  "version": "0.1.0",
  "description": "Agent-facing CLI for requesting and using FLUX human-managed wallet access.",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "flux-agent": "dist/cli.js",
    "flux-wallet-agent": "dist/cli.js"
