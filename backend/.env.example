# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL / Supabase ---
# Get this from: Supabase project → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Auth ---
# Strong random string; e.g. openssl rand -base64 48
SESSION_SECRET=change_me_in_production

# --- Mollie ---
# Use a test_ key for development. Leave empty to use the local mock checkout.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxx
# Optional explicit URLs. If omitted, FLUX_APP_URL is used to build them.
MOLLIE_WEBHOOK_URL=
MOLLIE_REDIRECT_URL=

# --- FLUX Internal ---
FLUX_TOKEN_TTL_SECONDS=30
FLUX_SESSION_TTL_SECONDS=86400
FLUX_PROVIDER_API_KEY=provider_xxxx
# Used to build Mollie redirectUrl / webhookUrl and mock checkout links.
FLUX_APP_URL=http://localhost:5173
