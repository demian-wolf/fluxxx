# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL / Supabase ---
# Get this from: Supabase project → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Auth ---
# Strong random string; e.g. openssl rand -base64 48
SESSION_SECRET=change_me_in_production

# --- Mollie ---
MOLLIE_API_KEY=live_xxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_URL=https://your-flux-app.example.com/api/webhooks/mollie
MOLLIE_REDIRECT_URL=https://your-flux-app.example.com/wallet/deposit/success

# --- FLUX Internal ---
FLUX_TOKEN_TTL_SECONDS=30
FLUX_SESSION_TTL_SECONDS=86400
FLUX_PROVIDER_API_KEY=provider_xxxx
FLUX_APP_URL=your-flux-app.example.com
