# FLUX frontend configuration.
#
# When VITE_USE_MOCK is "true" (default) the app runs entirely against an
# in-memory mock of the FLUX backend so it is fully demoable with no server.
# Set it to "false" and point VITE_API_BASE_URL at a running FLUX backend
# (the Express service under ./backend, see backend-architecture.md).
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:3000
